# CloseAI / OpenAI 兼容接口（示例占位，请替换为真实值）
OPENAI_API_KEY=sk-your-closeai-api-key
OPENAI_BASE_URL=https://api.closeai-asia.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_AVAILABLE_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1

# 服务
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 数据库（相对 backend 工作目录）
DATABASE_URL=sqlite+aiosqlite:///./data/chat.db
